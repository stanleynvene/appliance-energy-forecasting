# The raw CSV (5.7 MB) IS committed, so the pipeline runs from a fresh clone
# without depending on the UCI server. Interim and processed files are
# regenerated by the pipeline and are not tracked.
data/interim/*
data/processed/*
!data/**/.gitkeep

# Large model objects
outputs/model_objects/*
!outputs/model_objects/.gitkeep
*.pkl
*.joblib

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# OS
.DS_Store
